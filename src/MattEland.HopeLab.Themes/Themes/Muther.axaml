  <Color x:Key="Lab.Surface.Sidebar.Color">#FF030A05</Color>
  <SolidColorBrush x:Key="Lab.Surface.Sidebar" Color="{StaticResource Lab.Surface.Sidebar.Color}" />

  <!-- accent -->
