  <!-- border -->
  <Color x:Key="Lab.Border.Header.Color">#4C58D6FF</Color>
  <SolidColorBrush x:Key="Lab.Border.Header" Color="{StaticResource Lab.Border.Header.Color}" />
  <Color x:Key="Lab.Border.Subtle.Color">#1778D2FF</Color>
