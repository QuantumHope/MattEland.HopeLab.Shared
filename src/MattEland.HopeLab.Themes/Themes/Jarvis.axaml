  <Color x:Key="Lab.Border.Input.Color">#6158D6FF</Color>
  <SolidColorBrush x:Key="Lab.Border.Input" Color="{StaticResource Lab.Border.Input.Color}" />
  <Color x:Key="Lab.Border.Focus.Color">#E66EE0FF</Color>
  <SolidColorBrush x:Key="Lab.Border.Focus" Color="{StaticResource Lab.Border.Focus.Color}" />

  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF07141D" />
    <GradientStop Offset="1" Color="#FF040D14" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF08151E" />
    <GradientStop Offset="1" Color="#FF040B11" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#2458D6FF" />
    <GradientStop Offset="1" Color="#0F58D6FF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#0D58D6FF" />
    <GradientStop Offset="1" Color="#08BDEBFF" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 12 0 #4CFF8EC6</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #4C6EB4FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #4CB7A0FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #66F2D45C</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #A6F2D45C</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #99B7A0FF</BoxShadows>

  <!-- viz -->
