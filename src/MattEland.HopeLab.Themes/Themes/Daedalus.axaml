  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #477DB8F0</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #47B8A4F5</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #66EED36A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #A6EED36A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #99B8A4F5</BoxShadows>

