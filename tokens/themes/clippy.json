  "chrome": {
    "red": "#F25022",
    "green": "#7FBA00",
    "blue": "#00A4EF",
    "yellow": "#FFB900",
    "navy": "#000080",
    "title-end": "#1084D0",
    "face": "#C0C0C0",
    "light": "#DFDFDF",
    "hilite": "#FFFFFF",
    "shadow": "#808080",
    "dark": "#0A0A0A",
    "balloon": "#FFFFE1",
    "wire": "#5E6A75",
