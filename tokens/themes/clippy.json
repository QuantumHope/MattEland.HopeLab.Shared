{
  "id": "clippy",
  "name": "Clippy",
  "description": "Office 97 assistant",
  "scheme": "light",
  "highContrast": false,
  "icon": "paperclip",
  "motto": "Tip: Press Enter to send. Shift+Enter starts a new line.",
  "tokens": {
    "surface.canvas": "#C0C0C0",
    "surface.panel": "#FFFFFF",
    "surface.elevated": "#C0C0C0",
    "surface.header": "#C0C0C0",
    "surface.header-end": "#C0C0C0",
    "surface.sidebar": "#C0C0C0",
    "accent.primary": "#930B55",
    "accent.highlight": "#5E4B00",
    "accent.link": "#5E2B93",
    "accent.info": "#004D96",
    "accent.success": "#0B5B0B",
    "accent.error": "#9C1212",
    "accent.warning": "#843800",
    "ink.icon": "#FFFFFF",
    "ink.overlay": "#000000",
    "persona.face": "#FFFFFF",
    "persona.live": "#0067B8",
    "persona.mane": "#3A4A6E",
    "persona.hot": "#FFB900",
