    <GradientStop Offset="0.25" Color="#FFF25022" />
    <GradientStop Offset="0.25" Color="#FF7FBA00" />
    <GradientStop Offset="0.5" Color="#FF7FBA00" />
    <GradientStop Offset="0.5" Color="#FF00A4EF" />
    <GradientStop Offset="0.75" Color="#FF00A4EF" />
    <GradientStop Offset="0.75" Color="#FFFFB900" />
    <GradientStop Offset="1" Color="#FFFFB900" />
