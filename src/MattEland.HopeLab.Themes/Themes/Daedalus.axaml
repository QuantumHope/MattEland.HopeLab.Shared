<!--
  Daedalus: ECHELON signals intercept.
  GENERATED by tools/ThemeTokens from tokens/themes/daedalus.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Daedalus">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF070B0E</Color>
