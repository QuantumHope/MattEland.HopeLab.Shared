  <Color x:Key="Lab.Fluent.Region">#FF070B0E</Color>
  <Color x:Key="Lab.Fluent.BaseHigh">#FFD8E3E7</Color>
  <Color x:Key="Lab.Fluent.ChromeMedium">#FF18232A</Color>
  <Color x:Key="Lab.Fluent.ChromeMediumLow">#FF10181D</Color>
  <Color x:Key="Lab.Fluent.ChromeLow">#FF0B1216</Color>
  <Color x:Key="Lab.Fluent.ErrorText">#FFFF6B5E</Color>

  <!-- Type scale (size, weight, and line height in pixels), spacing and radii -->
  <x:Double x:Key="Lab.Type.Display.Size">28</x:Double>
  <FontWeight x:Key="Lab.Type.Display.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Display.LineHeight">33.6</x:Double>
  <x:Double x:Key="Lab.Type.Heading.Size">20</x:Double>
  <FontWeight x:Key="Lab.Type.Heading.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Heading.LineHeight">26</x:Double>
  <x:Double x:Key="Lab.Type.Subheading.Size">16</x:Double>
  <FontWeight x:Key="Lab.Type.Subheading.Weight">Medium</FontWeight>
  <x:Double x:Key="Lab.Type.Subheading.LineHeight">22.4</x:Double>
  <x:Double x:Key="Lab.Type.Body.Size">14</x:Double>
  <FontWeight x:Key="Lab.Type.Body.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Body.LineHeight">22.4</x:Double>
  <x:Double x:Key="Lab.Type.Label.Size">12</x:Double>
  <FontWeight x:Key="Lab.Type.Label.Weight">Medium</FontWeight>
  <x:Double x:Key="Lab.Type.Label.LineHeight">16.8</x:Double>
  <x:Double x:Key="Lab.Type.Micro.Size">11</x:Double>
  <FontWeight x:Key="Lab.Type.Micro.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Micro.LineHeight">15.4</x:Double>
  <x:Double x:Key="Lab.Type.Machine.Size">12</x:Double>
  <FontWeight x:Key="Lab.Type.Machine.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Machine.LineHeight">18</x:Double>
  <x:Double x:Key="Lab.Space.Xs">4</x:Double>
  <x:Double x:Key="Lab.Space.Sm">8</x:Double>
  <x:Double x:Key="Lab.Space.Md">16</x:Double>
  <x:Double x:Key="Lab.Space.Lg">24</x:Double>
  <x:Double x:Key="Lab.Space.Xl">32</x:Double>
  <x:Double x:Key="Lab.Space.2xl">48</x:Double>
