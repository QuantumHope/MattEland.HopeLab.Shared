<!--
  WOPR: War Operation Plan Response.
  GENERATED by tools/ThemeTokens from tokens/themes/wopr.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Wopr">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF020611</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
