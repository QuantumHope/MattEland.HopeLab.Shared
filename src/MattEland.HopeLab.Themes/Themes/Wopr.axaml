  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF071431" />
    <GradientStop Offset="1" Color="#FF040B1C" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF071226" />
    <GradientStop Offset="1" Color="#FF030915" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1FF49AC6" />
    <GradientStop Offset="1" Color="#1AB7A2F7" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#145C96FF" />
    <GradientStop Offset="1" Color="#0A6FC2FF" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 12 0 #47F49AC6</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #526FC2FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #47B7A2F7</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #66EFDC6A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #A6EFDC6A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #99B7A2F7</BoxShadows>

