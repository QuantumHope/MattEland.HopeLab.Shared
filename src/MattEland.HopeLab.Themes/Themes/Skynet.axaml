  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF17191C" />
    <GradientStop Offset="1" Color="#FF0E0F11" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141618" />
    <GradientStop Offset="1" Color="#FF0A0607" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#21FF8FB6" />
    <GradientStop Offset="1" Color="#1AB8A0FF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#0FD4D9DE" />
    <GradientStop Offset="1" Color="#0A7DB7FF" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 12 0 #4CFF8FB6</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #4C7DB7FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #4CB8A0FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #66EFD35A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #A6EFD35A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #99B8A0FF</BoxShadows>

