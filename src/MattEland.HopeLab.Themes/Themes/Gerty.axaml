  <Color x:Key="Lab.Viz.Axis.Color">#994A463F</Color>
  <SolidColorBrush x:Key="Lab.Viz.Axis" Color="{StaticResource Lab.Viz.Axis.Color}" />
  <Color x:Key="Lab.Viz.Heat1.Color">#FF2A6BB8</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat1" Color="{StaticResource Lab.Viz.Heat1.Color}" />
  <Color x:Key="Lab.Viz.Heat2.Color">#FF1A8F52</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat2" Color="{StaticResource Lab.Viz.Heat2.Color}" />
  <Color x:Key="Lab.Viz.Heat3.Color">#FFD2A300</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat3" Color="{StaticResource Lab.Viz.Heat3.Color}" />
  <Color x:Key="Lab.Viz.Heat4.Color">#FFC25C12</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat4" Color="{StaticResource Lab.Viz.Heat4.Color}" />
  <Color x:Key="Lab.Viz.Heat5.Color">#FF7A1512</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat5" Color="{StaticResource Lab.Viz.Heat5.Color}" />

  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Body">avares://MattEland.HopeLab.Themes/Assets/Fonts#Nunito, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Display">avares://MattEland.HopeLab.Themes/Assets/Fonts#Nunito, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Surface">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>

  <!-- Derived: the primary accent under the pointer, washes behind badges and banners, the dialog scrim -->
  <SolidColorBrush x:Key="Lab.Accent.Primary.Hot" Color="#FF86123E" />
  <SolidColorBrush x:Key="Lab.Wash.Primary" Color="#29A8174E" />
  <SolidColorBrush x:Key="Lab.Wash.Error" Color="#29B3201C" />
  <SolidColorBrush x:Key="Lab.Wash.Link" Color="#297A3E9C" />
  <SolidColorBrush x:Key="Lab.Wash.Warning" Color="#299C4600" />
