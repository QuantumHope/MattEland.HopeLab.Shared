  <Color x:Key="Lab.Fluent.Region">#FF0A0805</Color>
  <Color x:Key="Lab.Fluent.BaseHigh">#FFEDE4D0</Color>
  <Color x:Key="Lab.Fluent.ChromeMedium">#FF1D170E</Color>
  <Color x:Key="Lab.Fluent.ChromeMediumLow">#FF14100A</Color>
  <Color x:Key="Lab.Fluent.ChromeLow">#FF0E0B07</Color>
  <Color x:Key="Lab.Fluent.ErrorText">#FFFF6F5E</Color>

  <!-- Type scale (size, weight, and line height in pixels), spacing and radii -->
  <x:Double x:Key="Lab.Type.Display.Size">28</x:Double>
  <FontWeight x:Key="Lab.Type.Display.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Display.LineHeight">33.6</x:Double>
