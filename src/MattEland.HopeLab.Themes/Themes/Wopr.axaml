  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Body">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Display">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Surface">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>

  <!-- Derived: the primary accent under the pointer, washes behind badges and banners, the dialog scrim -->
  <SolidColorBrush x:Key="Lab.Accent.Primary.Hot" Color="#FFF7B8D7" />
  <SolidColorBrush x:Key="Lab.Wash.Primary" Color="#29F49AC6" />
