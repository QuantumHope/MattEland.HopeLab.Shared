    "viz.series-4": "#A06A00",
    "viz.grid": "rgba(0, 0, 0, 0.22)",
    "viz.axis": "rgba(0, 0, 0, 0.60)",
    "viz.heat-1": "#2a6bb8",
    "viz.heat-2": "#1a8f52",
    "viz.heat-3": "#d2a300",
    "viz.heat-4": "#c25c12",
    "viz.heat-5": "#7a1512",
    "persona.line": "1.1",
    "persona.plate": "1",
    "persona.seam": "1.2",
    "persona.glow": "0",
    "persona.chrome": "clippy",
    "font.mono": "Tahoma, Verdana, \"Lucida Console\", monospace",
    "font.body": "Tahoma, Verdana, \"MS Sans Serif\", \"Segoe UI\", system-ui, sans-serif",
    "font.display": "Tahoma, Verdana, \"MS Sans Serif\", \"Segoe UI\", system-ui, sans-serif",
    "font.surface": "Tahoma, Verdana, \"Segoe UI\", system-ui, sans-serif"
