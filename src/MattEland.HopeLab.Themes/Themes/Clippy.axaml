  <x:String x:Key="Lab.Theme.Name">Clippy</x:String>
  <x:String x:Key="Lab.Theme.Motto">Tip: Press Enter to send. Shift+Enter starts a new line.</x:String>

  <!-- Chrome: this theme's own decoration colours (decoration only; never text or meaning) -->
  <SolidColorBrush x:Key="Lab.Chrome.Red" Color="#FFF25022" />
  <SolidColorBrush x:Key="Lab.Chrome.Green" Color="#FF7FBA00" />
  <SolidColorBrush x:Key="Lab.Chrome.Blue" Color="#FF00A4EF" />
  <SolidColorBrush x:Key="Lab.Chrome.Yellow" Color="#FFFFB900" />
  <SolidColorBrush x:Key="Lab.Chrome.Navy" Color="#FF000080" />
