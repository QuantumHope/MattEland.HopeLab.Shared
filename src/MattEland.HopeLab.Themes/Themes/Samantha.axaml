  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="#FFFBEADF" />
    <GradientStop Offset="0.55" Color="#FFF8E8DD" />
    <GradientStop Offset="1" Color="#FFF6E0D2" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFFFF8F2" />
    <GradientStop Offset="1" Color="#FFF9EEE5" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#24E8604C" />
    <GradientStop Offset="1" Color="#1FF4A08A" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#4CF9D3BE" />
    <GradientStop Offset="1" Color="#1AFFFAF5" />
  </LinearGradientBrush>

