  <Color x:Key="Lab.Viz.Series2.Color">#FFC94714</Color>
  <SolidColorBrush x:Key="Lab.Viz.Series2" Color="{StaticResource Lab.Viz.Series2.Color}" />
  <Color x:Key="Lab.Viz.Series3.Color">#FF068063</Color>
