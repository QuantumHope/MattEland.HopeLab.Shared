  <Color x:Key="Lab.Text.Disabled.Color">#FFA29D93</Color>
  <SolidColorBrush x:Key="Lab.Text.Disabled" Color="{StaticResource Lab.Text.Disabled.Color}" />

  <!-- border -->
  <Color x:Key="Lab.Border.Header.Color">#383A352C</Color>
  <SolidColorBrush x:Key="Lab.Border.Header" Color="{StaticResource Lab.Border.Header.Color}" />
  <Color x:Key="Lab.Border.Subtle.Color">#1F3A352C</Color>
  <SolidColorBrush x:Key="Lab.Border.Subtle" Color="{StaticResource Lab.Border.Subtle.Color}" />
  <Color x:Key="Lab.Border.Input.Color">#4C3A352C</Color>
  <SolidColorBrush x:Key="Lab.Border.Input" Color="{StaticResource Lab.Border.Input.Color}" />
  <Color x:Key="Lab.Border.Focus.Color">#F2E2661A</Color>
  <SolidColorBrush x:Key="Lab.Border.Focus" Color="{StaticResource Lab.Border.Focus.Color}" />

  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFECE9E2" />
    <GradientStop Offset="1" Color="#FFE0DCD3" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFF2EFE9" />
    <GradientStop Offset="1" Color="#FFEAE7E0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#21E2661A" />
    <GradientStop Offset="1" Color="#12E2661A" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1FF5C518" />
    <GradientStop Offset="1" Color="#0DF5C518" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 10 0 #33A8174E</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 10 0 #381D5C9E</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 10 0 #337A3E9C</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 12 0 #80F5C518</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 18 0 #BFF5C518</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 14 0 #4C7A3E9C</BoxShadows>

  <!-- viz -->
