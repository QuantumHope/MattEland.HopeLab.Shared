    "gradient.user-bubble": "linear-gradient(180deg, #FFFFE1 0%, #FFFFE1 100%)",
    "gradient.assistant-bubble": "linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 100%)",
    "glow.primary": "0 0 0 1px #930B55",
    "glow.info": "0 0 0 1px #004D96",
    "glow.link": "0 0 0 1px #5E2B93",
    "glow.node-active": "0 0 0 2px currentColor",
    "glow.highlight": "0 0 0 1px #000000",
    "glow.highlight-hover": "0 0 0 2px #000000",
    "glow.link-strong": "0 0 0 1px #5E2B93",
    "viz.series-1": "#2873CE",
