  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF041008" />
    <GradientStop Offset="1" Color="#FF061409" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF06120A" />
    <GradientStop Offset="1" Color="#FF020803" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1AFFD23F" />
    <GradientStop Offset="1" Color="#0DFFD23F" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1233FF66" />
    <GradientStop Offset="1" Color="#0833FF66" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 10 0 #66FF7AD9</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 10 0 #665CE1FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 10 0 #66B79CFF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 12 0 #73FFD23F</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 20 0 #B2FFD23F</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 16 0 #A6B79CFF</BoxShadows>

