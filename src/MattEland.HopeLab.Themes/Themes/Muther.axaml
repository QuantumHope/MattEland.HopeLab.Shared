  <Color x:Key="Lab.Accent.Error.Color">#FFFF5A4E</Color>
  <SolidColorBrush x:Key="Lab.Accent.Error" Color="{StaticResource Lab.Accent.Error.Color}" />
  <Color x:Key="Lab.Accent.Warning.Color">#FFFF9A3C</Color>
