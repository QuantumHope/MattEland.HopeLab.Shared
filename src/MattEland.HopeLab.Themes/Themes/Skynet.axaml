<!--
  Skynet: Cyberdyne defence network, T-800 HUD.
  GENERATED by tools/ThemeTokens from tokens/themes/skynet.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Skynet">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF0A0607</Color>
