  <x:String x:Key="Lab.Theme.Motto">NORAD · CHEYENNE MOUNTAIN · WAR OPERATION PLAN RESPONSE</x:String>

  <!-- Chrome: this theme's own decoration colours (decoration only; never text or meaning) -->
