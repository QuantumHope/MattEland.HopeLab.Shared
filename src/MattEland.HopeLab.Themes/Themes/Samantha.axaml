<!--
  Samantha: OS1 from Her, warm and close.
  GENERATED by tools/ThemeTokens from tokens/themes/samantha.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Samantha">

  <!-- surface -->
