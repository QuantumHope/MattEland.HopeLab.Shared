  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#Rajdhani, avares://MattEland.HopeLab.Themes/Assets/Fonts#Barlow, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Body">avares://MattEland.HopeLab.Themes/Assets/Fonts#Barlow, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Display">avares://MattEland.HopeLab.Themes/Assets/Fonts#Saira Condensed, avares://MattEland.HopeLab.Themes/Assets/Fonts#Barlow, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Surface">avares://MattEland.HopeLab.Themes/Assets/Fonts#Barlow, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>

  <!-- Derived: the primary accent under the pointer, washes behind badges and banners, the dialog scrim -->
  <SolidColorBrush x:Key="Lab.Accent.Primary.Hot" Color="#FFF6BED3" />
  <SolidColorBrush x:Key="Lab.Wash.Primary" Color="#29F2A2C0" />
