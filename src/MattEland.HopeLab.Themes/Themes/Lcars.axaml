    <GradientStop Offset="1" Color="#FF000000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF000000" />
    <GradientStop Offset="1" Color="#FF000000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#299999FF" />
    <GradientStop Offset="1" Color="#1FCC99CC" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#12FF9900" />
    <GradientStop Offset="1" Color="#0DFFCC99" />
  </LinearGradientBrush>

