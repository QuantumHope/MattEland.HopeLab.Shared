<!--
  MUTHER: MU-TH-UR 6000 phosphor terminal.
  GENERATED by tools/ThemeTokens from tokens/themes/muther.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Muther">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF020803</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
