  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF17120A" />
    <GradientStop Offset="1" Color="#FF0E0B07" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF14100A" />
    <GradientStop Offset="1" Color="#FF0A0805" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#29D9A441" />
    <GradientStop Offset="1" Color="#14F2A2C0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#0FD9A441" />
    <GradientStop Offset="1" Color="#0A8EC2F5" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 12 0 #4CF2A2C0</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #4C8EC2F5</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #4CC3A6F2</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #66EBE27A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #A6EBE27A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #99C3A6F2</BoxShadows>

