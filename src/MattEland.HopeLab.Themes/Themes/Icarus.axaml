  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141518" />
    <GradientStop Offset="1" Color="#FF0A0A0C" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF141518" />
    <GradientStop Offset="1" Color="#FF0D0E10" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1AE2E6EC" />
    <GradientStop Offset="1" Color="#1474B6FF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#1AA3101E" />
    <GradientStop Offset="1" Color="#0016171A" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 10 0 #47FF8CC8</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 10 0 #4774B6FF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 10 0 #47B39DFF</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 12 0 #61F2D24A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 20 0 #99F2D24A</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 16 0 #8CB39DFF</BoxShadows>

