  <SolidColorBrush x:Key="Lab.Chrome.Light" Color="#FFDFDFDF" />
  <SolidColorBrush x:Key="Lab.Chrome.Hilite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Lab.Chrome.Shadow" Color="#FF808080" />
  <SolidColorBrush x:Key="Lab.Chrome.Dark" Color="#FF0A0A0A" />
  <SolidColorBrush x:Key="Lab.Chrome.Balloon" Color="#FFFFFFE1" />
  <SolidColorBrush x:Key="Lab.Chrome.Wire" Color="#FF5E6A75" />
  <BoxShadows x:Key="Lab.Chrome.Raised">inset -1 -1 0 0 #FF0A0A0A, inset 1 1 0 0 #FFFFFFFF, inset -2 -2 0 0 #FF808080, inset 2 2 0 0 #FFDFDFDF</BoxShadows>
  <BoxShadows x:Key="Lab.Chrome.Pressed">inset -1 -1 0 0 #FFFFFFFF, inset 1 1 0 0 #FF0A0A0A, inset -2 -2 0 0 #FFDFDFDF, inset 2 2 0 0 #FF808080</BoxShadows>
  <BoxShadows x:Key="Lab.Chrome.Sunken">inset -1 -1 0 0 #FFFFFFFF, inset 1 1 0 0 #FF808080, inset -2 -2 0 0 #FFDFDFDF, inset 2 2 0 0 #FF0A0A0A</BoxShadows>
  <LinearGradientBrush x:Key="Lab.Chrome.Titlebar" StartPoint="0%,50%" EndPoint="100%,50%">
