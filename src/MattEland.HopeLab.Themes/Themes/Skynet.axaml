  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Body">avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Display">avares://MattEland.HopeLab.Themes/Assets/Fonts#Rajdhani, avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Surface">avares://MattEland.HopeLab.Themes/Assets/Fonts#IBM Plex Mono, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, monospace</FontFamily>

  <!-- Derived: the primary accent under the pointer, washes behind badges and banners, the dialog scrim -->
  <SolidColorBrush x:Key="Lab.Accent.Primary.Hot" Color="#FFFFB1CC" />
  <SolidColorBrush x:Key="Lab.Wash.Primary" Color="#29FF8FB6" />
