<!--
  Icarus: Majestic 12 countermeasure AI.
  GENERATED by tools/ThemeTokens from tokens/themes/icarus.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Icarus">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF0D0E10</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
  <Color x:Key="Lab.Surface.Panel.Color">#FF16171A</Color>
