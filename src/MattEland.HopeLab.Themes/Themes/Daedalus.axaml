  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF111B21" />
    <GradientStop Offset="1" Color="#FF0B1216" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF10181D" />
    <GradientStop Offset="1" Color="#FF080D10" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#21F59AC4" />
    <GradientStop Offset="1" Color="#1CB8A4F5" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#125EC4B6" />
    <GradientStop Offset="1" Color="#0A7DB8F0" />
  </LinearGradientBrush>

  <!-- glow -->
