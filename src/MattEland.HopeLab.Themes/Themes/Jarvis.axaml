  <CornerRadius x:Key="Lab.Radius">6</CornerRadius>
  <CornerRadius x:Key="Lab.Radius.Pill">10</CornerRadius>

  <!-- The assistant's line style, and which signature detail the theme's chrome draws -->
  <x:Double x:Key="Lab.Persona.Line">0.85</x:Double>
  <x:Double x:Key="Lab.Persona.Plate">0.7</x:Double>
  <x:Double x:Key="Lab.Persona.Seam">1.2</x:Double>
  <x:Double x:Key="Lab.Persona.Glow">4</x:Double>
  <x:String x:Key="Lab.Persona.Chrome">jarvis</x:String>
  <!-- The theme itself -->
  <x:String x:Key="Lab.Theme.Id">jarvis</x:String>
  <x:String x:Key="Lab.Theme.Name">JARVIS</x:String>
  <x:String x:Key="Lab.Theme.Motto">J.A.R.V.I.S. · STARK INDUSTRIES · MALIBU</x:String>

  <!-- Chrome: this theme's own decoration colours (decoration only; never text or meaning) -->
  <SolidColorBrush x:Key="Lab.Chrome.Cyan" Color="#FF58D6FF" />
  <SolidColorBrush x:Key="Lab.Chrome.Ice" Color="#FFBDEBFF" />
  <SolidColorBrush x:Key="Lab.Chrome.Line" Color="#3D58D6FF" />
