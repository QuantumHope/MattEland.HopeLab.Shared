  <!-- The theme itself -->
  <x:String x:Key="Lab.Theme.Id">eliza</x:String>
  <x:String x:Key="Lab.Theme.Name">Eliza Cassan</x:String>
  <x:String x:Key="Lab.Theme.Motto">PICUS COMMUNICATIONS · LIVE · DETROIT 2027</x:String>

  <!-- Chrome: this theme's own decoration colours (decoration only; never text or meaning) -->
