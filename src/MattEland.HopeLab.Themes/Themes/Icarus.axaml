  <Color x:Key="Lab.Surface.Sidebar.Color">#FF111215</Color>
  <SolidColorBrush x:Key="Lab.Surface.Sidebar" Color="{StaticResource Lab.Surface.Sidebar.Color}" />

  <!-- accent -->
  <Color x:Key="Lab.Accent.Primary.Color">#FFFF8CC8</Color>
