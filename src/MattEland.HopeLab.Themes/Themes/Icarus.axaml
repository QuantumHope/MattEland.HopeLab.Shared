  <Color x:Key="Lab.Fluent.Region">#FF0D0E10</Color>
  <Color x:Key="Lab.Fluent.BaseHigh">#FFE6E7EB</Color>
  <Color x:Key="Lab.Fluent.ChromeMedium">#FF1F2024</Color>
  <Color x:Key="Lab.Fluent.ChromeMediumLow">#FF16171A</Color>
  <Color x:Key="Lab.Fluent.ChromeLow">#FF0A0A0C</Color>
  <Color x:Key="Lab.Fluent.ErrorText">#FFFF6B3D</Color>

  <!-- Type scale (size, weight, and line height in pixels), spacing and radii -->
  <x:Double x:Key="Lab.Type.Display.Size">28</x:Double>
  <FontWeight x:Key="Lab.Type.Display.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Display.LineHeight">33.6</x:Double>
