  <!-- text -->
  <Color x:Key="Lab.Text.Primary.Color">#FFDCF2FF</Color>
  <SolidColorBrush x:Key="Lab.Text.Primary" Color="{StaticResource Lab.Text.Primary.Color}" />
  <Color x:Key="Lab.Text.Secondary.Color">#FF92B6CA</Color>
