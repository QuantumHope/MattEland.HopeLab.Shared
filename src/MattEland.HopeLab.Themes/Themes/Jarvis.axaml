<!--
  JARVIS: Stark workshop and helmet HUD.
  GENERATED by tools/ThemeTokens from tokens/themes/jarvis.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Jarvis">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF030A10</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
  <Color x:Key="Lab.Surface.Panel.Color">#FF08151E</Color>
  <SolidColorBrush x:Key="Lab.Surface.Panel" Color="{StaticResource Lab.Surface.Panel.Color}" />
  <Color x:Key="Lab.Surface.Elevated.Color">#FF0D1E29</Color>
  <SolidColorBrush x:Key="Lab.Surface.Elevated" Color="{StaticResource Lab.Surface.Elevated.Color}" />
  <Color x:Key="Lab.Surface.Header.Color">#FF040D14</Color>
  <SolidColorBrush x:Key="Lab.Surface.Header" Color="{StaticResource Lab.Surface.Header.Color}" />
  <Color x:Key="Lab.Surface.HeaderEnd.Color">#FF07141D</Color>
  <SolidColorBrush x:Key="Lab.Surface.HeaderEnd" Color="{StaticResource Lab.Surface.HeaderEnd.Color}" />
  <Color x:Key="Lab.Surface.Sidebar.Color">#FF050F17</Color>
  <SolidColorBrush x:Key="Lab.Surface.Sidebar" Color="{StaticResource Lab.Surface.Sidebar.Color}" />

  <!-- accent -->
  <Color x:Key="Lab.Accent.Primary.Color">#FFFF8EC6</Color>
  <SolidColorBrush x:Key="Lab.Accent.Primary" Color="{StaticResource Lab.Accent.Primary.Color}" />
  <Color x:Key="Lab.Accent.Highlight.Color">#FFF2D45C</Color>
  <SolidColorBrush x:Key="Lab.Accent.Highlight" Color="{StaticResource Lab.Accent.Highlight.Color}" />
  <Color x:Key="Lab.Accent.Link.Color">#FFB7A0FF</Color>
