  <CornerRadius x:Key="Lab.Radius">6</CornerRadius>
  <CornerRadius x:Key="Lab.Radius.Pill">10</CornerRadius>

  <!-- The assistant's line style, and which signature detail the theme's chrome draws -->
  <x:Double x:Key="Lab.Persona.Line">0.9</x:Double>
  <x:Double x:Key="Lab.Persona.Plate">0.8</x:Double>
  <x:Double x:Key="Lab.Persona.Seam">1.1</x:Double>
  <x:Double x:Key="Lab.Persona.Glow">0</x:Double>
  <x:String x:Key="Lab.Persona.Chrome">daedalus</x:String>
  <!-- The theme itself -->
  <x:String x:Key="Lab.Theme.Id">daedalus</x:String>
  <x:String x:Key="Lab.Theme.Name">Daedalus</x:String>
  <x:String x:Key="Lab.Theme.Motto">ECHELON IV · SIGNAL INTERCEPT · CLEARANCE: MAJESTIC</x:String>

  <!-- Chrome: this theme's own decoration colours (decoration only; never text or meaning) -->
  <SolidColorBrush x:Key="Lab.Chrome.Signal" Color="#FF5EC4B6" />
  <SolidColorBrush x:Key="Lab.Chrome.SignalDim" Color="#4C5EC4B6" />
  <SolidColorBrush x:Key="Lab.Chrome.Amber" Color="#FFE8B04A" />
  <SolidColorBrush x:Key="Lab.Chrome.Gunmetal" Color="#FF2B3840" />
  <SolidColorBrush x:Key="Lab.Chrome.Rule" Color="#1FC9DADF" />
  <SolidColorBrush x:Key="Lab.Chrome.BevelHi" Color="#24C9DADF" />
  <SolidColorBrush x:Key="Lab.Chrome.BevelLo" Color="#99000000" />
  <LinearGradientBrush x:Key="Lab.Chrome.Plate" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF1B262D" />
    <GradientStop Offset="1" Color="#FF121A1F" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Chrome.PlateRaised" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF2A3740" />
    <GradientStop Offset="1" Color="#FF1A242A" />
  </LinearGradientBrush>
</ResourceDictionary>
