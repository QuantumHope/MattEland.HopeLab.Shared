<!--
  Dark: CORA in the void.
  GENERATED by tools/ThemeTokens from tokens/themes/dark.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Dark">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF0A0A18</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
  <Color x:Key="Lab.Surface.Panel.Color">#FF1A1A2E</Color>
  <SolidColorBrush x:Key="Lab.Surface.Panel" Color="{StaticResource Lab.Surface.Panel.Color}" />
  <Color x:Key="Lab.Surface.Elevated.Color">#FF23233A</Color>
  <SolidColorBrush x:Key="Lab.Surface.Elevated" Color="{StaticResource Lab.Surface.Elevated.Color}" />
  <Color x:Key="Lab.Surface.Header.Color">#FF14102A</Color>
  <SolidColorBrush x:Key="Lab.Surface.Header" Color="{StaticResource Lab.Surface.Header.Color}" />
  <Color x:Key="Lab.Surface.HeaderEnd.Color">#FF1A1430</Color>
  <SolidColorBrush x:Key="Lab.Surface.HeaderEnd" Color="{StaticResource Lab.Surface.HeaderEnd.Color}" />
  <Color x:Key="Lab.Surface.Sidebar.Color">#FF0D0D1A</Color>
  <SolidColorBrush x:Key="Lab.Surface.Sidebar" Color="{StaticResource Lab.Surface.Sidebar.Color}" />

  <!-- accent -->
  <Color x:Key="Lab.Accent.Primary.Color">#FFF9A8C9</Color>
  <SolidColorBrush x:Key="Lab.Accent.Primary" Color="{StaticResource Lab.Accent.Primary.Color}" />
  <Color x:Key="Lab.Accent.Highlight.Color">#FFF7F478</Color>
  <SolidColorBrush x:Key="Lab.Accent.Highlight" Color="{StaticResource Lab.Accent.Highlight.Color}" />
  <Color x:Key="Lab.Accent.Link.Color">#FFC490D1</Color>
  <SolidColorBrush x:Key="Lab.Accent.Link" Color="{StaticResource Lab.Accent.Link.Color}" />
  <Color x:Key="Lab.Accent.Info.Color">#FF93BBF5</Color>
  <SolidColorBrush x:Key="Lab.Accent.Info" Color="{StaticResource Lab.Accent.Info.Color}" />
  <Color x:Key="Lab.Accent.Success.Color">#FFA8F0C6</Color>
  <SolidColorBrush x:Key="Lab.Accent.Success" Color="{StaticResource Lab.Accent.Success.Color}" />
  <Color x:Key="Lab.Accent.Error.Color">#FFF9A4A4</Color>
  <SolidColorBrush x:Key="Lab.Accent.Error" Color="{StaticResource Lab.Accent.Error.Color}" />
  <Color x:Key="Lab.Accent.Warning.Color">#FFF5B87A</Color>
  <SolidColorBrush x:Key="Lab.Accent.Warning" Color="{StaticResource Lab.Accent.Warning.Color}" />

  <!-- ink -->
  <Color x:Key="Lab.Ink.Icon.Color">#FF1C1228</Color>
  <SolidColorBrush x:Key="Lab.Ink.Icon" Color="{StaticResource Lab.Ink.Icon.Color}" />
  <Color x:Key="Lab.Ink.Overlay.Color">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Lab.Ink.Overlay" Color="{StaticResource Lab.Ink.Overlay.Color}" />

  <!-- persona -->
  <Color x:Key="Lab.Persona.Face.Color">#FFD8F2EA</Color>
  <SolidColorBrush x:Key="Lab.Persona.Face" Color="{StaticResource Lab.Persona.Face.Color}" />
  <Color x:Key="Lab.Persona.Live.Color">#FF35F5A0</Color>
  <SolidColorBrush x:Key="Lab.Persona.Live" Color="{StaticResource Lab.Persona.Live.Color}" />
  <Color x:Key="Lab.Persona.Mane.Color">#FF3B3260</Color>
  <SolidColorBrush x:Key="Lab.Persona.Mane" Color="{StaticResource Lab.Persona.Mane.Color}" />
  <Color x:Key="Lab.Persona.Hot.Color">#FFFFF4D2</Color>
  <SolidColorBrush x:Key="Lab.Persona.Hot" Color="{StaticResource Lab.Persona.Hot.Color}" />
  <Color x:Key="Lab.Persona.Signature.Color">#FFD8F2EA</Color>
  <SolidColorBrush x:Key="Lab.Persona.Signature" Color="{StaticResource Lab.Persona.Signature.Color}" />

  <!-- text -->
  <Color x:Key="Lab.Text.Primary.Color">#FFE8E0FF</Color>
  <SolidColorBrush x:Key="Lab.Text.Primary" Color="{StaticResource Lab.Text.Primary.Color}" />
  <Color x:Key="Lab.Text.Secondary.Color">#FF9A90C0</Color>
  <SolidColorBrush x:Key="Lab.Text.Secondary" Color="{StaticResource Lab.Text.Secondary.Color}" />
  <Color x:Key="Lab.Text.Mono.Color">#FF8A8AB0</Color>
  <SolidColorBrush x:Key="Lab.Text.Mono" Color="{StaticResource Lab.Text.Mono.Color}" />
  <Color x:Key="Lab.Text.Disabled.Color">#FF4A4470</Color>
  <SolidColorBrush x:Key="Lab.Text.Disabled" Color="{StaticResource Lab.Text.Disabled.Color}" />

  <!-- border -->
  <Color x:Key="Lab.Border.Header.Color">#40F9A8C9</Color>
  <SolidColorBrush x:Key="Lab.Border.Header" Color="{StaticResource Lab.Border.Header.Color}" />
  <Color x:Key="Lab.Border.Subtle.Color">#0FFFFFFF</Color>
  <SolidColorBrush x:Key="Lab.Border.Subtle" Color="{StaticResource Lab.Border.Subtle.Color}" />
  <Color x:Key="Lab.Border.Input.Color">#66C490D1</Color>
  <SolidColorBrush x:Key="Lab.Border.Input" Color="{StaticResource Lab.Border.Input.Color}" />
  <Color x:Key="Lab.Border.Focus.Color">#B2F9A8C9</Color>
  <SolidColorBrush x:Key="Lab.Border.Focus" Color="{StaticResource Lab.Border.Focus.Color}" />

  <!-- gradient -->
  <LinearGradientBrush x:Key="Lab.Gradient.Header" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#FF14102A" />
    <GradientStop Offset="1" Color="#FF1A1430" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.Sidebar" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FF1A1A2E" />
    <GradientStop Offset="1" Color="#FF0A0A18" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.UserBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#2EF9A8C9" />
    <GradientStop Offset="1" Color="#2EC490D1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Lab.Gradient.AssistantBubble" StartPoint="14.6%,14.6%" EndPoint="85.4%,85.4%">
    <GradientStop Offset="0" Color="#14C490D1" />
    <GradientStop Offset="1" Color="#0F93BBF5" />
  </LinearGradientBrush>

  <!-- glow -->
  <BoxShadows x:Key="Lab.Glow.Primary">0 0 12 0 #59F9A8C9</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Info">0 0 12 0 #5993BBF5</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Link">0 0 12 0 #59C490D1</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.Highlight">0 0 14 0 #73F7F478</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.HighlightHover">0 0 22 0 #B2F7F478</BoxShadows>
  <BoxShadows x:Key="Lab.Glow.LinkStrong">0 0 18 0 #B2C490D1</BoxShadows>

  <!-- viz -->
  <Color x:Key="Lab.Viz.Series1.Color">#FF3987E5</Color>
  <SolidColorBrush x:Key="Lab.Viz.Series1" Color="{StaticResource Lab.Viz.Series1.Color}" />
  <Color x:Key="Lab.Viz.Series2.Color">#FFD95926</Color>
  <SolidColorBrush x:Key="Lab.Viz.Series2" Color="{StaticResource Lab.Viz.Series2.Color}" />
  <Color x:Key="Lab.Viz.Series3.Color">#FF199E70</Color>
  <SolidColorBrush x:Key="Lab.Viz.Series3" Color="{StaticResource Lab.Viz.Series3.Color}" />
  <Color x:Key="Lab.Viz.Series4.Color">#FFC98500</Color>
  <SolidColorBrush x:Key="Lab.Viz.Series4" Color="{StaticResource Lab.Viz.Series4.Color}" />
  <Color x:Key="Lab.Viz.Grid.Color">#4C9A90C0</Color>
  <SolidColorBrush x:Key="Lab.Viz.Grid" Color="{StaticResource Lab.Viz.Grid.Color}" />
  <Color x:Key="Lab.Viz.Axis.Color">#A69A90C0</Color>
  <SolidColorBrush x:Key="Lab.Viz.Axis" Color="{StaticResource Lab.Viz.Axis.Color}" />
  <Color x:Key="Lab.Viz.Heat1.Color">#FF4A8AE0</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat1" Color="{StaticResource Lab.Viz.Heat1.Color}" />
  <Color x:Key="Lab.Viz.Heat2.Color">#FF33B56A</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat2" Color="{StaticResource Lab.Viz.Heat2.Color}" />
  <Color x:Key="Lab.Viz.Heat3.Color">#FFE3CF2A</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat3" Color="{StaticResource Lab.Viz.Heat3.Color}" />
  <Color x:Key="Lab.Viz.Heat4.Color">#FFF28B1F</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat4" Color="{StaticResource Lab.Viz.Heat4.Color}" />
  <Color x:Key="Lab.Viz.Heat5.Color">#FFD2352F</Color>
  <SolidColorBrush x:Key="Lab.Viz.Heat5" Color="{StaticResource Lab.Viz.Heat5.Color}" />

  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>
  <FontFamily x:Key="Lab.Font.Body">avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, DM Sans, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Display">avares://MattEland.HopeLab.Themes/Assets/Fonts#Inter, DM Sans, sans-serif</FontFamily>
  <FontFamily x:Key="Lab.Font.Surface">avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, Fira Code, Cascadia Code, monospace</FontFamily>

  <!-- Derived: the primary accent under the pointer, washes behind badges and banners, the dialog scrim -->
  <SolidColorBrush x:Key="Lab.Accent.Primary.Hot" Color="#FFFBC2D9" />
  <SolidColorBrush x:Key="Lab.Wash.Primary" Color="#29F9A8C9" />
  <SolidColorBrush x:Key="Lab.Wash.Error" Color="#29F9A4A4" />
  <SolidColorBrush x:Key="Lab.Wash.Link" Color="#29C490D1" />
  <SolidColorBrush x:Key="Lab.Wash.Warning" Color="#29F5B87A" />
  <SolidColorBrush x:Key="Lab.Wash.Hover" Color="#0DE8E0FF" />
  <SolidColorBrush x:Key="Lab.Wash.Selected" Color="#1FF9A8C9" />
  <SolidColorBrush x:Key="Lab.Scrim" Color="#B30A0A18" />
  <!-- Derived: chart slots 5 to 7 and Other, which the tokens don't cover, at 3:1 on the panel -->
  <SolidColorBrush x:Key="Lab.Viz.Series5" Color="#FFD55181" />
  <SolidColorBrush x:Key="Lab.Viz.Series6" Color="#FF008300" />
  <SolidColorBrush x:Key="Lab.Viz.Series7" Color="#FF9085E9" />
  <SolidColorBrush x:Key="Lab.Viz.Other" Color="#FF6E6C80" />
  <!-- Derived: Fluent's palette, for apps that build FluentTheme from the theme -->
  <Color x:Key="Lab.Fluent.Accent">#FFF9A8C9</Color>
  <Color x:Key="Lab.Fluent.Region">#FF0A0A18</Color>
  <Color x:Key="Lab.Fluent.BaseHigh">#FFE8E0FF</Color>
  <Color x:Key="Lab.Fluent.ChromeMedium">#FF23233A</Color>
  <Color x:Key="Lab.Fluent.ChromeMediumLow">#FF1A1A2E</Color>
  <Color x:Key="Lab.Fluent.ChromeLow">#FF14102A</Color>
  <Color x:Key="Lab.Fluent.ErrorText">#FFF9A4A4</Color>

  <!-- Type scale (size, weight, and line height in pixels), spacing and radii -->
  <x:Double x:Key="Lab.Type.Display.Size">28</x:Double>
  <FontWeight x:Key="Lab.Type.Display.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Display.LineHeight">33.6</x:Double>
  <x:Double x:Key="Lab.Type.Heading.Size">20</x:Double>
  <FontWeight x:Key="Lab.Type.Heading.Weight">SemiBold</FontWeight>
  <x:Double x:Key="Lab.Type.Heading.LineHeight">26</x:Double>
  <x:Double x:Key="Lab.Type.Subheading.Size">16</x:Double>
  <FontWeight x:Key="Lab.Type.Subheading.Weight">Medium</FontWeight>
  <x:Double x:Key="Lab.Type.Subheading.LineHeight">22.4</x:Double>
  <x:Double x:Key="Lab.Type.Body.Size">14</x:Double>
  <FontWeight x:Key="Lab.Type.Body.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Body.LineHeight">22.4</x:Double>
  <x:Double x:Key="Lab.Type.Label.Size">12</x:Double>
  <FontWeight x:Key="Lab.Type.Label.Weight">Medium</FontWeight>
  <x:Double x:Key="Lab.Type.Label.LineHeight">16.8</x:Double>
  <x:Double x:Key="Lab.Type.Micro.Size">11</x:Double>
  <FontWeight x:Key="Lab.Type.Micro.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Micro.LineHeight">15.4</x:Double>
  <x:Double x:Key="Lab.Type.Machine.Size">12</x:Double>
  <FontWeight x:Key="Lab.Type.Machine.Weight">Normal</FontWeight>
  <x:Double x:Key="Lab.Type.Machine.LineHeight">18</x:Double>
  <x:Double x:Key="Lab.Space.Xs">4</x:Double>
  <x:Double x:Key="Lab.Space.Sm">8</x:Double>
  <x:Double x:Key="Lab.Space.Md">16</x:Double>
  <x:Double x:Key="Lab.Space.Lg">24</x:Double>
  <x:Double x:Key="Lab.Space.Xl">32</x:Double>
  <x:Double x:Key="Lab.Space.2xl">48</x:Double>
  <x:Double x:Key="Lab.Space.3xl">64</x:Double>
  <CornerRadius x:Key="Lab.Radius">6</CornerRadius>
  <CornerRadius x:Key="Lab.Radius.Pill">10</CornerRadius>

  <!-- The assistant's line style, and which signature detail the theme's chrome draws -->
  <x:Double x:Key="Lab.Persona.Line">1</x:Double>
  <x:Double x:Key="Lab.Persona.Plate">1</x:Double>
  <x:Double x:Key="Lab.Persona.Seam">1</x:Double>
  <x:Double x:Key="Lab.Persona.Glow">0</x:Double>
  <x:String x:Key="Lab.Persona.Chrome">none</x:String>
  <!-- The theme itself -->
  <x:String x:Key="Lab.Theme.Id">dark</x:String>
  <x:String x:Key="Lab.Theme.Name">Dark</x:String>
  <x:String x:Key="Lab.Theme.Motto">&#160;</x:String>
</ResourceDictionary>
