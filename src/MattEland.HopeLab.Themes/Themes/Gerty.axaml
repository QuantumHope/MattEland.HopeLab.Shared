  <!-- text -->
  <Color x:Key="Lab.Text.Primary.Color">#FF24221E</Color>
  <SolidColorBrush x:Key="Lab.Text.Primary" Color="{StaticResource Lab.Text.Primary.Color}" />
  <Color x:Key="Lab.Text.Secondary.Color">#FF4A463F</Color>
