<!--
  GERTY: Sarang lunar base.
  GENERATED by tools/ThemeTokens from tokens/themes/gerty.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Gerty">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FFE6E3DC</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
  <Color x:Key="Lab.Surface.Panel.Color">#FFF6F4EF</Color>
  <SolidColorBrush x:Key="Lab.Surface.Panel" Color="{StaticResource Lab.Surface.Panel.Color}" />
  <Color x:Key="Lab.Surface.Elevated.Color">#FFFAF9F5</Color>
  <SolidColorBrush x:Key="Lab.Surface.Elevated" Color="{StaticResource Lab.Surface.Elevated.Color}" />
  <Color x:Key="Lab.Surface.Header.Color">#FFECE9E2</Color>
  <SolidColorBrush x:Key="Lab.Surface.Header" Color="{StaticResource Lab.Surface.Header.Color}" />
  <Color x:Key="Lab.Surface.HeaderEnd.Color">#FFE0DCD3</Color>
  <SolidColorBrush x:Key="Lab.Surface.HeaderEnd" Color="{StaticResource Lab.Surface.HeaderEnd.Color}" />
  <Color x:Key="Lab.Surface.Sidebar.Color">#FFEFECE6</Color>
  <SolidColorBrush x:Key="Lab.Surface.Sidebar" Color="{StaticResource Lab.Surface.Sidebar.Color}" />

  <!-- accent -->
  <Color x:Key="Lab.Accent.Primary.Color">#FFA8174E</Color>
  <SolidColorBrush x:Key="Lab.Accent.Primary" Color="{StaticResource Lab.Accent.Primary.Color}" />
  <Color x:Key="Lab.Accent.Highlight.Color">#FF655700</Color>
  <SolidColorBrush x:Key="Lab.Accent.Highlight" Color="{StaticResource Lab.Accent.Highlight.Color}" />
  <Color x:Key="Lab.Accent.Link.Color">#FF7A3E9C</Color>
  <SolidColorBrush x:Key="Lab.Accent.Link" Color="{StaticResource Lab.Accent.Link.Color}" />
  <Color x:Key="Lab.Accent.Info.Color">#FF1D5C9E</Color>
  <SolidColorBrush x:Key="Lab.Accent.Info" Color="{StaticResource Lab.Accent.Info.Color}" />
  <Color x:Key="Lab.Accent.Success.Color">#FF236434</Color>
  <SolidColorBrush x:Key="Lab.Accent.Success" Color="{StaticResource Lab.Accent.Success.Color}" />
  <Color x:Key="Lab.Accent.Error.Color">#FFB3201C</Color>
  <SolidColorBrush x:Key="Lab.Accent.Error" Color="{StaticResource Lab.Accent.Error.Color}" />
  <Color x:Key="Lab.Accent.Warning.Color">#FF9C4600</Color>
  <SolidColorBrush x:Key="Lab.Accent.Warning" Color="{StaticResource Lab.Accent.Warning.Color}" />

  <!-- ink -->
  <Color x:Key="Lab.Ink.Icon.Color">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Lab.Ink.Icon" Color="{StaticResource Lab.Ink.Icon.Color}" />
  <Color x:Key="Lab.Ink.Overlay.Color">#FF24221E</Color>
  <SolidColorBrush x:Key="Lab.Ink.Overlay" Color="{StaticResource Lab.Ink.Overlay.Color}" />

  <!-- persona -->
  <Color x:Key="Lab.Persona.Face.Color">#FFFBFAF6</Color>
  <SolidColorBrush x:Key="Lab.Persona.Face" Color="{StaticResource Lab.Persona.Face.Color}" />
  <Color x:Key="Lab.Persona.Live.Color">#FF13A05B</Color>
  <SolidColorBrush x:Key="Lab.Persona.Live" Color="{StaticResource Lab.Persona.Live.Color}" />
  <Color x:Key="Lab.Persona.Mane.Color">#FF5E594F</Color>
  <SolidColorBrush x:Key="Lab.Persona.Mane" Color="{StaticResource Lab.Persona.Mane.Color}" />
  <Color x:Key="Lab.Persona.Hot.Color">#FFF29A1E</Color>
