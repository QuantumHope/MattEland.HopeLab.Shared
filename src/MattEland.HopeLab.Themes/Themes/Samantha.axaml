  <!-- font -->
  <FontFamily x:Key="Lab.Font.Mono">avares://MattEland.HopeLab.Themes/Assets/Fonts#Quicksand, avares://MattEland.HopeLab.Themes/Assets/Fonts#Nunito, avares://MattEland.HopeLab.Themes/Assets/Fonts#JetBrains Mono, sans-serif</FontFamily>
