<!--
  Eliza Cassan: Picus newsroom, black and gold.
  GENERATED by tools/ThemeTokens from tokens/themes/eliza.json. Edit the token file and regenerate.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="MattEland.HopeLab.Themes.Dictionaries.Eliza">

  <!-- surface -->
  <Color x:Key="Lab.Surface.Canvas.Color">#FF0A0805</Color>
  <SolidColorBrush x:Key="Lab.Surface.Canvas" Color="{StaticResource Lab.Surface.Canvas.Color}" />
